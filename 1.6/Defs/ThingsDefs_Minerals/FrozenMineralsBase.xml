<?xml version="1.0" encoding="UTF-8"?>
<Defs>


  <ThingDef Name="MF_FrozenMineralBase" ParentName="MF_DynamicMineralBase" Abstract="True">
    <!-- What stage of map generation the thing is spawned during (rocks or ice) -->
    <newMapGenStep>ice</newMapGenStep>
    <!-- Order in which minerals are spawned during map generation (lower numbers first) -->
    <newMapSpawnOrder>200</newMapSpawnOrder>
    <!-- at what snow depth the snow texture is used, if it exists -->
    <snowTextureThreshold>0.8</snowTextureThreshold>
    <!-- at what snow depth the mineral is completely hidden -->
    <hiddenInSnowThreshold>999</hiddenInSnowThreshold>
    <!-- How nearby things or terrains affect spawn abundance -->
    <nearbyThingAbundEffects>
      <li>
        <defNames>
          <li>HotSpring</li>
        </defNames>
        <radius>0</radius>
        <foundFactor>0</foundFactor>
        <notFoundFactor>1</notFoundFactor>
      </li>
    </nearbyThingAbundEffects>
    <filthLeaving></filthLeaving>
  </ThingDef>


</Defs>
